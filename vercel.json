{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "functions": { "api/**/*.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1/models", "destination": "/api/v1/models" },
    { "source": "/v1/responses", "destination": "/api/v1/responses" },
    { "source": "/v1/chat/completions", "destination": "/api/v1/chat/completions" }
  ]
}
